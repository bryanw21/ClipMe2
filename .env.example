# Environment
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Auth (for login)
GOOGLE_CLIENT_ID="your_google_id_here"
GOOGLE_CLIENT_SECRET="your_google_secret_here"

# Optional legacy hosted clipping fallback
AICLIPS_API_KEY="your_clipping_provider_key_here"
WEBHOOK_URL="your_webhook_url"

# ClipMee self-hosted Python processing service
CLIP_ENGINE_URL="http://localhost:8000"
CLIP_ENGINE_SHARED_SECRET="replace_with_a_long_random_secret"

# Meta / Facebook / Instagram connection
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Encrypt connected social-account tokens at rest
DATA_ENCRYPTION_KEY="replace_with_a_long_random_secret"

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Dynamic UI Theme Configuration
# Hosted Admins: Choose between: indigo, emerald, rose, amber, violet
NEXT_PUBLIC_THEME=emerald
